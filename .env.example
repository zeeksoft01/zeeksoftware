# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAYSTACK INTEGRATION CONFIGURATION
# Provide your Paystack Secret Key (e.g. sk_test_... or sk_live_...) in AI Studio Secrets or environment
PAYSTACK_SECRET_KEY="sk_test_your_secret_key_here"
PAYSTACK_PUBLIC_KEY="pk_test_your_public_key_here"
PAYSTACK_MODE="test"

# ADMIN ACCESS & SESSION SIGNING SECURITY (Required in production)
# Set a strong password for master admin access and a 32+ char random secret for JWT/HMAC signing
ADMIN_SECRET_KEY="change_this_to_a_strong_admin_password"
AUTH_JWT_SECRET="change_this_to_a_long_random_signing_secret"

# PRODUCTION CORS & API DOCS
# Comma-separated allowed origins (leave empty in production to restrict to APP_URL/same-origin)
CORS_ORIGIN=""
ENABLE_SWAGGER="false"

# MONGODB DATABASE CONFIGURATION
# Provide your MongoDB Compass local URL or MongoDB Atlas connection string.
# Compass Local Example: mongodb://127.0.0.1:27017/zeek_softwares
# Atlas Example: mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/zeek_softwares?retryWrites=true&w=majority
MONGODB_URI=""

# Optional: Specify database name (defaults to 'zeek_softwares' if omitted or extracted from URI)
MONGODB_DB_NAME="zeek_softwares"

# CLOUDINARY IMAGE UPLOAD CONFIGURATION
# Required for uploading product, hero slider, and brand images via Admin Dashboard
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="zeek-softwares"
# Optional alternative single-line URL: CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"

# EMAIL CONFIGURATION — BREVO (Required for contact form & transactional emails)
# Option A (Recommended): Brevo Transactional Email API
BREVO_API_KEY=""
BREVO_SENDER_EMAIL="Zeeksoftwares@gmail.com"
BREVO_SENDER_NAME="Zeek Softwares"
CONTACT_EMAIL="Zeeksoftwares@gmail.com"

# Option B (Optional fallback): Brevo SMTP Relay
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# FRONTEND API BASE URL (Optional)
# Leave empty when running full-stack on port 3000.
# Set to http://localhost:5000 if running the standalone backend/ server separately.
VITE_API_BASE_URL=""
