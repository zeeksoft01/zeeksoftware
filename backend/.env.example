# Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# MongoDB Configuration (Compass Local or MongoDB Atlas)
# Local Compass Example: mongodb://127.0.0.1:27017/zeek_softwares
# Atlas Example: mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/zeek_softwares?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/zeek_softwares
MONGODB_DB_NAME=zeek_softwares

# Admin Security (Required: set a strong password & JWT secret in .env or AI Studio Secrets)
ADMIN_SECRET_KEY=change_this_to_a_strong_admin_password
AUTH_JWT_SECRET=change_this_to_a_long_random_signing_secret
ENABLE_SWAGGER=false

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_MODE=test

# Email Delivery — Brevo API v3 & SMTP Relay (Required for contact form, enquiries & emails)
# Option A (Recommended): Brevo Transactional Email API (https://api.brevo.com/v3/smtp/email)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=Zeeksoftwares@gmail.com
BREVO_SENDER_NAME=Zeek Softwares
CONTACT_EMAIL=Zeeksoftwares@gmail.com

# Option B (SMTP Relay — e.g. smtp-relay.brevo.com or custom SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Cloudinary Image Upload Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=zeek-softwares
# Optional single-line URL alternative:
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
